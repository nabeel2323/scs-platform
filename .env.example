# ============================================================
# Smart Commerce & Supply Platform — Environment Variables
# ============================================================
# Copy this file to .env.local and adjust values as needed.
# NEVER commit .env.local — it is in .gitignore.
# ============================================================

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://scs:scs_dev_2026@localhost:5432/scs_platform
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── S3 / MinIO ─────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=scs_minio
S3_SECRET_KEY=scs_minio_2026
S3_MEDIA_BUCKET=scs-media
S3_UPLOADS_BUCKET=scs-uploads
S3_CDN_URL=http://localhost:9000/scs-media

# ── SMTP (Mailhog) ─────────────────────────────────────────
# Email is the ONLY OTP channel the initial staging release permits, so SMTP is
# the delivery path that must work. Read by resolveSmtpConfig() in
# apps/api/src/modules/notifications/providers/provider.config.ts.
# Minimum for "configured": SMTP_HOST and SMTP_FROM. Auth is optional (Mailhog
# needs none); a real relay normally needs SMTP_USER + SMTP_PASSWORD.
SMTP_HOST=localhost
SMTP_PORT=1025
# TLS/security mode. 'true' = implicit TLS from the first byte (typically port
# 465). 'false' = plaintext upgrade via STARTTLS when the server offers it
# (typically port 587, or 1025 for Mailhog). Passed straight to Nodemailer's
# `secure` option; there is no separate SMTP_TLS_MODE variable.
SMTP_SECURE=false
SMTP_FROM=noreply@scsp.dev
# Sender display name shown in the recipient's inbox. Optional; empty means the
# address alone is used.
SMTP_FROM_NAME=SCS Platform
# SMTP_USER=            # Uncomment for authenticated SMTP
# SMTP_PASSWORD=        # Uncomment for authenticated SMTP (use an app password)

# ── JWT ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-32chars!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-32chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── OTP ────────────────────────────────────────────────────
# Channel ALLOWLIST — which public channels this deployment permits at all.
# Comma-separated; permitted names are exactly: email, sms, whatsapp.
# Unset or blank => email only (the initial staging release defers SMS so no SMS
# provider cost is incurred during testing). Setting TWILIO_* does NOT enable
# SMS: permission and credential presence are independent axes, and a channel
# sends only when it is BOTH permitted and configured.
# An unknown name (e.g. a typo) or an empty list aborts startup rather than
# silently widening or disabling channels. 'mock' is never configurable here.
# There is NO cross-channel fallback: if the permitted channel's send fails, the
# request fails — it is never retried over SMS.
# OTP_CHANNELS=email
OTP_LENGTH=6
OTP_TTL=90
OTP_MAX_ATTEMPTS=5
# HMAC secret for OTP challenge storage protection (min 32 chars).
# WARNING: the value below is the committed example/development default. It is
# REFUSED at startup outside development/test (see config/env-gate.ts). Generate a
# unique secret for any deployed environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_SECRET=dev-hmac-secret-change-me-in-production-64chars-minimum!!
# F-10 (S1.38): explicit opt-in for the internal mock OTP delivery provider.
# REQUIRED for automated tests and local development. Must be 'true' AND NODE_ENV
# must be 'development' or 'test'. NEVER set in staging/production.
OTP_MOCK_ENABLED=true

# ── Device trust credential (S-1) ──────────────────────────
# Trusted-device state is a server-issued 256-bit credential stored ONLY as a
# SHA-256 digest (table public.device_credentials, migration 0066) and
# delivered to the browser in a host-only HttpOnly cookie. Trust is granted
# only when the cookie AND the non-safelisted proof header `x-device-trust: 1`
# arrive together, which is the CSRF control for SameSite=None.
#
# The lifetimes are code constants, not configuration: 30-day sliding horizon,
# 90-day hard ceiling (apps/api/src/modules/identity/identity.service.ts:67-68).
#
# Attributes are resolved and validated at boot — an invalid combination aborts
# startup rather than silently shipping a weaker cookie.
# lax | strict | none. Defaults: lax in development/test, none in
# staging/production (the frontends and the API are different sites there).
# DEVICE_TRUST_COOKIE_SAME_SITE=lax
# true | false. Must be true anywhere the cookie is not localhost-only.
# DEVICE_TRUST_COOKIE_SECURE=true

# ── Device-check probe limits (S-2) ────────────────────────
# POST /v1/auth/login/device-check now answers a constant {checked:true}, so
# these limits bound cost and make sustained probing observable rather than
# preventing enumeration (there is nothing left to enumerate).
# Per source IP, managed by the ThrottlerGuard (Redis-backed storage).
# DEVICE_CHECK_THROTTLE_TTL_MS=60000
# DEVICE_CHECK_THROTTLE_LIMIT=10
# Per normalized identifier, enforced in the service: 20 requests / 900s.
# Exceeding it only logs a warning; the answer is unchanged either way.

# ── Notification Providers (S1.1) ─────────────────────────
# DEFERRED, not required. The initial staging release permits email only, so
# these may stay empty: absent SMS/WhatsApp credentials are the expected state,
# produce no readiness problem, and never block startup. The implementations are
# preserved for a later phase. To activate SMS later you must BOTH add `sms` to
# OTP_CHANNELS AND supply all three Twilio values below — see
# docs/reports/OTP-EMAIL-ONLY-STAGING-ACTIVATION.md.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_TEMPLATE_NAME=authentication
# Meta Graph API version for WhatsApp sends (validated as v<major>.<minor>).
# Default when unset is v18.0. Confirm the version is currently supported by Meta
# before deploying; this is a configuration knob, not an endorsement of currency.
# WHATSAPP_API_VERSION=v18.0

# ── SMS Providers ──────────────────────────────────────────
# INERT: no source file in this repository reads either name. They are not the
# OTP channel switch — that is OTP_CHANNELS above. Kept only so nobody mistakes
# them for one; the generic notifications module's SMS failover is stubbed
# (notifications.service.ts smsProviderPrimary/smsProviderFallback) and is NOT
# reachable from the auth OTP path.
SMS_PRIMARY_PROVIDER=mock
SMS_SECONDARY_PROVIDER=mock

# ── FCM ────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Maps ───────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ── App ────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3100,http://localhost:3200
LOG_LEVEL=debug

# ── OpenTelemetry ──────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=scs-api

# ── Feature Flags (defaults) ──────────────────────────────
FLAGS_PREPAY_ENABLED=false
FLAGS_B2C_ENABLED=false
FLAGS_ADS_ENABLED=false
# Kill switch for the email-OTP and account-linking routes. Left FALSE here so
# the committed default stays fail-closed, but the email-only staging release
# CANNOT work with it off: every /v1/auth/otp/email/* and /v1/account/* identifier
# route returns 404. Staging must set FLAG_AUTH_EMAIL_OTP=true.
FLAG_AUTH_EMAIL_OTP=false

# ── Bootstrap ownership (initial Super Admin provisioning) ────────────────
# SCS_BOOTSTRAP_OWNER_EMAIL is the root of trust for initializing a fresh
# deployment. The bootstrap one-time password is sent ONLY to this address, and
# the initial Super Admin's email is marked verified only after successful owner
# verification. Required for staging and production initial setup; fail-closed
# if missing or invalid outside development/test (see config/env-gate.ts).
# Never expose the complete address publicly — the API returns a masked hint only.
# Example: SCS_BOOTSTRAP_OWNER_EMAIL=platform-owner@example.com
SCS_BOOTSTRAP_OWNER_EMAIL=
