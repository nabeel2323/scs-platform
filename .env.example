# ============================================================
# Smart Commerce & Supply Platform — Environment Variables
# ============================================================
# Copy this file to .env.local and adjust values as needed.
# NEVER commit .env.local — it is in .gitignore.
# ============================================================

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://scs:scs_dev_2026@localhost:5432/scs_platform
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── S3 / MinIO ─────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=scs_minio
S3_SECRET_KEY=scs_minio_2026
S3_MEDIA_BUCKET=scs-media
S3_UPLOADS_BUCKET=scs-uploads
S3_CDN_URL=http://localhost:9000/scs-media

# ── SMTP (Mailhog) ─────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@scsp.dev

# ── JWT ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-32chars!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-32chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── OTP ────────────────────────────────────────────────────
OTP_PROVIDER=mock
OTP_LENGTH=6
OTP_TTL=90
OTP_MAX_ATTEMPTS=5
# HMAC secret for OTP challenge storage protection (min 32 chars).
# WARNING: the value below is the committed example/development default. It is
# REFUSED at startup outside development/test (see config/env-gate.ts). Generate a
# unique secret for any deployed environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_SECRET=dev-hmac-secret-change-me-in-production-64chars-minimum!!

# ── Notification Providers (S1.1) ─────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_TEMPLATE_NAME=authentication
# Meta Graph API version for WhatsApp sends (validated as v<major>.<minor>).
# Default when unset is v18.0. Confirm the version is currently supported by Meta
# before deploying; this is a configuration knob, not an endorsement of currency.
# WHATSAPP_API_VERSION=v18.0

# ── SMS Providers ──────────────────────────────────────────
SMS_PRIMARY_PROVIDER=mock
SMS_SECONDARY_PROVIDER=mock

# ── FCM ────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Maps ───────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ── App ────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3100,http://localhost:3200
LOG_LEVEL=debug

# ── OpenTelemetry ──────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=scs-api

# ── Feature Flags (defaults) ──────────────────────────────
FLAGS_PREPAY_ENABLED=false
FLAGS_B2C_ENABLED=false
FLAGS_ADS_ENABLED=false
