# Generated — reproducible via `pnpm contracts:generate` / `generate:ts`.
# CI regenerates the spec, so these build artifacts are not committed. (The
# previous entries pointed at openapi/generated/ and src/generated/, which are
# not the real output paths — the spec lands at openapi/openapi.json and the TS
# client at generated/api.d.ts.)
packages/contracts/openapi/openapi.json
packages/contracts/generated/
# Dart client generated by `pnpm --filter @scs/contracts generate:dart`
# (openapi-generator-cli, needs Java 11+). Regenerated on demand; the mobile app
# wires consumption separately.
mobile/packages/api_client/

