# ============================================================
# Smart Commerce & Supply Platform — production-like environment template
# ============================================================
# Introduced by P13 Phase 4.1. This file contains NO secrets. It is the documented
# shape of the configuration that `infra/docker-compose.prod.yml` expects.
#
#   cp infra/deploy/.env.production.example .env.prod-like
#   # edit .env.prod-like
#   docker compose --env-file .env.prod-like -f infra/docker-compose.prod.yml up -d
#
# `.env.prod-like` is git-ignored (`.env.*` in .gitignore) and docker-ignored
# (`.env*` in .dockerignore), so a filled copy can neither be committed nor baked
# into an image. Do not put real values in THIS template.
#
# The applications read `process.env` directly — there is no dotenv/@nestjs/config
# loader in this repository — so these names are exactly the strings the code looks
# up. Each entry below cites where it is consumed.

# ── 1. Boot-blocking credentials ─────────────────────────────
# The API cannot start without these. `StorageService`'s constructor THROWS if
# S3_ENDPOINT or the two S3 keys are missing (common/storage/storage.service.ts),
# `RedisService.onModuleInit` awaits a real connect(), and `assertJwtConfig()`
# refuses to boot on a missing/weak/dev-default JWT secret outside development.

# REQUIRED. Signs access tokens. Minimum 16 characters, and it must NOT be the
# well-known development default 'dev-secret-change-me-min-16-chars!!'
# Consumed: config/env-gate.ts, modules/identity/identity.module.ts
JWT_ACCESS_SECRET=__REPLACE_ME_generate_with_openssl_rand_base64_32__

# REQUIRED. PostgreSQL password for role `scs`. It is interpolated into
# DATABASE_URL by Compose, so it must be URL-safe: no '@', ':', '/', '#', '%'.
# Consumed: infra/docker-compose.prod.yml (postgres service + DATABASE_URL)
POSTGRES_PASSWORD=__REPLACE_ME_url_safe__

# REQUIRED. Redis password. Redis is not a cache here — it holds the JWT denylist
# checked on every authenticated request (common/guards/jwt-auth.guard.ts), so it must
# be authenticated. Consumed: redis --requirepass + REDIS_URL
REDIS_PASSWORD=__REPLACE_ME__

# REQUIRED. Object-store credentials. StorageService throws without both.
# Consumed: common/storage/storage.service.ts
S3_ACCESS_KEY=__REPLACE_ME__
S3_SECRET_KEY=__REPLACE_ME_min_8_chars_for_minio__

# ── 2. Required non-secret configuration ─────────────────────

# REQUIRED. Comma-separated browser origins allowed to call the API.
# Consumed: main.ts (`API_CORS_ORIGINS?.split(',')`). Without it the code falls back
# to localhost:3100/3200, which is wrong in production and fails silently for real
# users, so Compose treats it as mandatory.
API_CORS_ORIGINS=https://shop.example.com,https://admin.example.com

# REQUIRED. The origin BROWSERS reach the API at. This is baked into the web and
# admin bundles at build time (NEXT_PUBLIC_* is inlined by Next), so it is a build
# argument, not a runtime variable. Not a secret: anything a browser can call is public.
PUBLIC_API_URL=https://api.example.com

# ── 3. Database name and pool sizing ─────────────────────────
POSTGRES_DB=scs_platform
# Consumed: common/database/database.service.ts reads DATABASE_POOL_MAX (code default
# 20). DATABASE_POOL_MIN is present in the dev .env but is NOT read by any code path —
# it is listed here only because the Compose file passes it through, and it has no
# effect today.
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=1

# ── 4. Object storage names ──────────────────────────────────
# Consumed: storage.service.ts (these two are the only allowed buckets), payments,
# catalog, merchant, admin services.
S3_REGION=us-east-1
S3_MEDIA_BUCKET=scs-media
S3_UPLOADS_BUCKET=scs-uploads

# ── 5. Observability ─────────────────────────────────────────
# Consumed: main.ts pino level. 'info' is the production default.
LOG_LEVEL=info

# ── 6. Image and topology knobs (Compose-only, no app effect) ─
SCS_IMAGE_TAG=prod-like
# Two API replicas is the shape the P13 lease was designed for; one also works.
API_REPLICAS=2

# ── 7. P13 operational posture — READ BEFORE CHANGING ────────
# Every default in this block is the safe one, and the safe one is also what a
# production release must ship while the pilot is inactive.
#
# P13_WORKER_ENABLED is NOT set here on purpose. The API tier hard-codes "false" in
# the Compose file, and the worker only exists behind the `p13-worker` profile. There
# is deliberately no variable that turns the worker on "by accident" — enabling it
# requires editing the profile service or starting it explicitly:
#   docker compose --profile p13-worker up -d worker
#
# Pilot enforcement mode: 'legacy' keeps pre-P13 behaviour. 'allowlist' routes
# returns through the pilot allowlist, and an empty/unreadable allowlist DENIES
# everything (fail-closed). Consumed: modules/operations/p13-ops.config.ts
P13_PILOT_MODE=legacy
# Live-holder count the monitor expects. 0 disables its check #3 via the
# `expectedWorkerCount > 0` guard, which is correct while no worker runs. Set to 1
# exactly when the worker profile is enabled.
P13_EXPECTED_WORKER_COUNT=0
# Alert sink. EMPTY means log-only: alerts are written to `ops_alerts` and the log,
# and never silently dropped. This is the documented Phase 4 limitation. There is no
# repository-hosted value for this — a real webhook URL is an operator secret and
# must not be committed. Populate it only in your private copy, and see the Phase 4.1
# alert-delivery-readiness report for the verification procedure.
P13_OPS_ALERT_WEBHOOK_URL=
# Cadence and thresholds. Defaults come from p13-ops.config.ts; heartbeat is clamped
# to <= 50% of the lease TTL by code, so a wrong value here cannot create split
# ownership. Only override what you have a reason to change.
# P13_WORKER_POLL_INTERVAL_MS=120000
# P13_WORKER_LEASE_TTL_SECONDS=90
# P13_WORKER_HEARTBEAT_INTERVAL_MS=30000
# P13_WORKER_STARTUP_DELAY_MS=45000
# P13_WORKER_ACQUIRE_RETRY_MS=20000
# P13_MONITOR_INTERVAL_MS=60000
# P13_ALERT_DELIVERY_TIMEOUT_MS=5000
# P13_ALERT_REPEAT_WINDOW_MS=900000

# ── 8. TLS to a managed PostgreSQL (only when applicable) ────
# migrate-pg.ts enables `rejectUnauthorized: true` TLS when this file path exists.
# Leave unset for the Compose-internal network.
# PGSSLROOTCERT=/run/secrets/pg-ca.pem

# ── 9. Present in the dev .env but NOT read by the API ───────
# Listed so nobody assumes they work. Do not spend an incident discovering this.
#   JWT_REFRESH_SECRET — refresh tokens are opaque UUIDs stored as
#     sessions.token_hash; nothing signs or verifies with this value.
#   JWT_ACCESS_TTL / JWT_REFRESH_TTL — access-token expiry is hard-coded to '15m' in
#     identity.module.ts; session lifetime is hard-coded to 30 days in
#     identity.service.ts.
#   OTEL_*, FCM_*, MAPBOX_ACCESS_TOKEN, SMS_*, SMTP_* — consumed by integrations that
#     are outside the P13 scope; verify before relying on them in a release.
