{
  "name": "@scs/api",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Commerce & Supply Platform — NestJS Modular Monolith API",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:unit": "vitest run --dir src/__tests__/unit",
    "test:integration": "vitest run --dir src/__tests__/integration",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx infra/drizzle/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx infra/drizzle/reset.ts",
    "db:generate": "drizzle-kit generate",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "drizzle-orm": "^0.33.0",
    "postgres": "^3.4.4",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2",
    "helmet": "^7.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.52.1",
    "@opentelemetry/auto-instrumentations-node": "^0.49.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.1",
    "@types/node": "^20.16.0",
    "@types/express": "^4.17.21",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@testcontainers/postgresql": "^10.11.0",
    "eslint": "^9.9.0",
    "rimraf": "^6.0.1"
  }
}
